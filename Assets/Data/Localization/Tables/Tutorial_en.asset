  m_TableData:
  - m_Id: 27841523712
    m_Localized: Press W, A, S, D to move
    m_Metadata:
      m_Items: []
  - m_Id: 27875078144
    m_Localized: Press Space to pick up or put down a chick
    m_Metadata:
      m_Items: []
  - m_Id: 27875078145
    m_Localized: 'Put a chick in front of the mirror to duplicate

      Chickens
      and eggs cannot be duplicated'
    m_Metadata:
      m_Items: []
  - m_Id: 27875078146
    m_Localized: Duplicate as many chicks as you can before time runs out!
    m_Metadata:
      m_Items: []
  - m_Id: 27875078147
    m_Localized: You can buy various items in the shop
    m_Metadata:
      m_Items: []
  - m_Id: 27875078148
    m_Localized: 'CHECK shows your remaining debt and lets you pay it

      Press
      the CHECK button'
    m_Metadata:
      m_Items: []
  - m_Id: 27875078149
    m_Localized: 'A, D keys select the digit,

      W, S keys change the number

      Try
      paying at least 10 gold'
    m_Metadata:
      m_Items: []
  - m_Id: 27875078150
    m_Localized: 'Fail to pay your debt on time and it''s game over

      Let''s
      start!'
    m_Metadata:
      m_Items: []
  - m_Id: 27875078151
    m_Localized: Next
    m_Metadata:
      m_Items: []
